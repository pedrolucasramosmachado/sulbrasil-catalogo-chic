# Exemplo de variáveis de ambiente do Catálogo Sulbrasil
# Copie este arquivo para .env.local e preencha com seus dados reais

# Supabase Configuration
VITE_SUPABASE_URL=https://sua-url-aqui.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
VITE_SUPABASE_PROJECT_ID=seu-id-de-projeto

# Cloudflare R2 Storage (Opcional - para upload de imagens)
VITE_R2_ACCOUNT_ID=seu-account-id
VITE_R2_BUCKET_NAME=seu-bucket-name
VITE_R2_PUBLIC_URL=https://public-url.r2.dev
VITE_R2_ACCESS_KEY_ID=seu-access-key
VITE_R2_SECRET_ACCESS_KEY=seu-secret-key
